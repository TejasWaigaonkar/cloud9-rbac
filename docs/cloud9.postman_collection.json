{
  "info": {
    "name": "Cloud9 RBAC",
    "description": "Run requests individually; root for administration, demo_editor for denied DELETE. IDs and credentials are local environment values.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Login (save local tokens)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/token/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Login succeeds\", () => pm.response.to.have.status(200));",
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.environment.set(\"access_token\", data.access); pm.environment.set(\"refresh_token\", data.refresh); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Refresh (rotate local tokens)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/refresh/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) { const data = pm.response.json(); pm.environment.set(\"access_token\", data.access); pm.environment.set(\"refresh_token\", data.refresh); }"
            ]
          }
        }
      ]
    },
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/health/",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "Readiness",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/ready/",
        "auth": {
          "type": "noauth"
        }
      }
    },
    {
      "name": "List project permissions",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/permissions/?content_type__app_label=projects"
      }
    },
    {
      "name": "Create role",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/roles/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman Reviewer\",\n  \"code\": \"postman-reviewer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Created\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.environment.set(\"role_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "List roles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/roles/?is_active=true"
      }
    },
    {
      "name": "Map permission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/roles/{{role_id}}/permissions/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"permission_id\": \"{{permission_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Assign to different user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/users/{{target_user_id}}/roles/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"role_id\": \"{{role_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Effective access",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/users/{{target_user_id}}/permissions/"
      }
    },
    {
      "name": "Assigned roles",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/users/{{target_user_id}}/roles/"
      }
    },
    {
      "name": "Read projects (grant required)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/projects/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Allowed\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create project",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/projects/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Postman project\",\n  \"description\": \"Example\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.environment.set(\"project_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Publish project",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{base_url}}/api/projects/{{project_id}}/publish/"
      }
    },
    {
      "name": "Forbidden delete (run as demo_editor)",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/projects/{{project_id}}/"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Forbidden for editor\", () => pm.response.to.have.status(403));"
            ]
          }
        }
      ]
    },
    {
      "name": "Create custom permission",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/permissions/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Export example\",\n  \"codename\": \"custom_example_export\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) pm.environment.set(\"custom_permission_id\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Update custom permission name",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/permissions/{{custom_permission_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Export revised\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete unused custom permission",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/permissions/{{custom_permission_id}}/"
      }
    },
    {
      "name": "Deactivate role",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/roles/{{role_id}}/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"is_active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Revoke role",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/users/{{target_user_id}}/roles/{{role_id}}/"
      }
    },
    {
      "name": "Remove mapping",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/roles/{{role_id}}/permissions/{{permission_id}}/"
      }
    },
    {
      "name": "Delete role",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/api/roles/{{role_id}}/"
      }
    },
    {
      "name": "Audit evidence",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/audit-logs/"
      }
    },
    {
      "name": "Logout refresh",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/api/auth/logout/",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "auth": {
          "type": "noauth"
        }
      }
    }
  ]
}
