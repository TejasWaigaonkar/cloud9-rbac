# Copy to .env. Generate secrets locally; never commit .env.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=cloud9
POSTGRES_USER=cloud9
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Production TLS origin, e.g. https://rbac.example.com
CSRF_TRUSTED_ORIGINS=
# Set 1 only behind a trusted proxy that overwrites X-Forwarded-Proto.
TRUST_PROXY_PROTO=0
